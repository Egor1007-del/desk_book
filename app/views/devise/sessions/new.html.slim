- content_for :title, t("sessions.new.title")

.container.py-4
  .row.justify-content-center
    .col-12.col-sm-9.col-md-7.col-lg-5
      .card.border-0.shadow-sm
        .card-body.p-4.p-md-5
          p.text-uppercase.text-secondary.small.fw-semibold.mb-2 = t("brand.name")
          h1.h3.mb-2 = t("sessions.new.title")
          p.text-secondary.mb-4 = t("sessions.new.description")

          = simple_form_for(resource, as: resource_name, url: session_path(resource_name)) do |form|
            = form.input :login,
              required: true,
              autofocus: true,
              input_html: { autocomplete: "username" }
            = form.input :password,
              required: true,
              input_html: { autocomplete: "current-password" }
            = form.button :submit, t("navigation.sign_in"), class: "btn btn-primary w-100"
