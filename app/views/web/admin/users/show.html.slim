- content_for :title, @user.full_name

.container.py-4
  .d-flex.flex-column.flex-sm-row.align-items-sm-center.justify-content-between.gap-3.mb-4
    div
      p.text-uppercase.text-secondary.small.fw-semibold.mb-2 = t("brand.admin")
      h1.h2.mb-1 = @user.full_name
      p.text-secondary.mb-0 = @user.position.name
    .d-flex.gap-2
      = link_to t("actions.edit"), edit_admin_user_path(@user), class: "btn btn-primary"
      - if policy([:admin, @user]).destroy?
        = button_to t("actions.delete"), admin_user_path(@user), method: :delete,
          class: "btn btn-outline-danger",
          data: { turbo: false, turbo_confirm: t("users.confirm_delete", name: @user.full_name) }

  .card.border-0.shadow-sm
    .card-body
      dl.row.mb-0
        dt.col-sm-4 = User.human_attribute_name(:position)
        dd.col-sm-8 = @user.position.name
        dt.col-sm-4 = User.human_attribute_name(:hired_on)
        dd.col-sm-8 = l(@user.hired_on, format: :long)
        dt.col-sm-4 = User.human_attribute_name(:phone)
        dd.col-sm-8 = @user.phone.presence || "—"
        dt.col-sm-4 = User.human_attribute_name(:email)
        dd.col-sm-8 = @user.email.presence || "—"
        dt.col-sm-4 = User.human_attribute_name(:login)
        dd.col-sm-8 = @user.login
        dt.col-sm-4 = User.human_attribute_name(:role_name)
        dd.col-sm-8 = t("roles.#{@user.role_name}")

  .mt-4
    = link_to t("actions.back_to_management"), admin_users_path, class: "btn btn-outline-secondary"
