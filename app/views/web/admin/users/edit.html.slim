- content_for :title, t("admin.users.edit.title", name: @user.full_name)

.container.py-4
  - if turbo_frame_request?
    = turbo_frame_tag "admin_user_form" do
      = render "form_panel", user: @user,
        title: t("admin.users.edit.title", name: @user.full_name)
  - else
    .mb-4
      p.text-uppercase.text-secondary.small.fw-semibold.mb-2 = t("brand.admin")
      h1.h2.mb-1 = t("admin.users.edit.title", name: @user.full_name)

    = render "form", user: @user
