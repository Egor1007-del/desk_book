- content_for :title, t("profiles.edit.title")

.container.py-5
  .d-flex.flex-column.flex-sm-row.align-items-sm-center.justify-content-between.gap-3.mb-4
    div
      p.text-uppercase.text-secondary.small.fw-semibold.mb-2 = t("brand.name")
      h1.h2.mb-1 = t("profiles.edit.title")
      p.text-secondary.mb-0 = @user.full_name
    = link_to t("actions.back_to_directory"), users_path, class: "btn btn-outline-secondary"

  .card.border-0.shadow-sm
    .card-body
      = simple_form_for @user, url: profile_path, method: :patch do |form|
        = form.error_notification

        .row.g-3
          .col-12.col-md-6
            = form.input :phone
          .col-12.col-md-6
            = form.input :email
          .col-12.col-md-6
            = form.input :login, required: true
          .col-12.col-md-6
            = form.input :password, required: false,
              hint: t("forms.password_hint")
          .col-12.col-md-6
            = form.input :password_confirmation, required: false

        .mt-4
          = form.button :submit, t("profiles.edit.save"), class: "btn btn-primary"
