- content_for :title, t("brand.name")
- github_url = "https://github.com/Egor1007-del/desk_book"

.container.py-4.py-lg-5
  section.home-hero.rounded-4.p-4.p-lg-5.mb-4
    .row.align-items-center.g-5
      .col-lg-7
        p.home-kicker.mb-3 = t("home.kicker")
        h1.display-5.fw-bold.mb-3 = t("home.title")
        p.lead.text-secondary.mb-4 = t("home.description")
        .d-flex.flex-wrap.gap-2
          - if policy([:admin, User]).index?
            = link_to t("admin.users.index.title"), admin_users_path, class: "btn btn-dark btn-lg"
          - else
            = link_to t("users.index.open"), users_path, class: "btn btn-dark btn-lg"
          = link_to t("profiles.edit.title"), edit_profile_path, class: "btn btn-outline-dark btn-lg"
          = link_to github_url, class: "btn btn-link text-dark",
            target: "_blank", rel: "noopener" do
            = t("home.github")
      .col-lg-5
        .home-summary.rounded-4.p-4
          p.text-uppercase.small.fw-semibold.text-secondary.mb-3 = t("home.summary.title")
          p.fs-4.fw-semibold.mb-3 = current_user.full_name
          p.display-4.fw-bold.mb-3 = t("employees.count", count: @employees_count)
          p.text-secondary.mb-0 = t("home.summary.description")

  .row.g-4
    .col-lg-5
      .card.border-0.shadow-sm.h-100
        .card-body.p-4
          p.home-kicker.mb-2 = t("home.parable.title")
          blockquote.mb-0
            p.fs-5.mb-3 = t("home.parable.body")
            footer.text-secondary = t("home.parable.conclusion")
    .col-lg-7
      .accordion.shadow-sm#directory-guide
        .accordion-item
          h2.accordion-header
            button.accordion-button(
              type="button"
              data-bs-toggle="collapse"
              data-bs-target="#directory-purpose"
              aria-expanded="true"
              aria-controls="directory-purpose"
            )
              = t("home.guide.purpose.question")
          #directory-purpose.accordion-collapse.collapse.show[data-bs-parent="#directory-guide"]
            .accordion-body
              = t("home.guide.purpose.answer")
        .accordion-item
          h2.accordion-header
            button.accordion-button.collapsed(
              type="button"
              data-bs-toggle="collapse"
              data-bs-target="#directory-access"
              aria-expanded="false"
              aria-controls="directory-access"
            )
              = t("home.guide.access.question")
          #directory-access.accordion-collapse.collapse[data-bs-parent="#directory-guide"]
            .accordion-body
              = t("home.guide.access.answer")
        .accordion-item
          h2.accordion-header
            button.accordion-button.collapsed(
              type="button"
              data-bs-toggle="collapse"
              data-bs-target="#directory-habit"
              aria-expanded="false"
              aria-controls="directory-habit"
            )
              = t("home.guide.habit.question")
          #directory-habit.accordion-collapse.collapse[data-bs-parent="#directory-guide"]
            .accordion-body
              = t("home.guide.habit.answer")
