- content_for :title, @user.full_name

.container.py-5
  .d-flex.flex-column.flex-sm-row.align-items-sm-center.justify-content-between.gap-3.mb-4
    div
      p.text-uppercase.text-secondary.small.fw-semibold.mb-2 = t("brand.name")
      h1.h2.mb-1 = @user.full_name
      p.text-secondary.mb-0 = t("users.show.hired", position: @user.position&.name,
        date: l(@user.hired_on, format: :long))

  .row.g-4
    .col-12.col-md-6
      .card.border-0.shadow-sm
        .card-header.bg-white.border-0
          h5.fw-semibold.mb-0 = t("users.show.contact")
        .card-body
          dl.row.mb-0
            dt.col-sm-3 = User.human_attribute_name(:phone)
            dd.col-sm-9 = @user.phone.presence || "—"
            dt.col-sm-3 = User.human_attribute_name(:email)
            dd.col-sm-9 = @user.email.presence || "—"

    .col-12.col-md-6
      .card.border-0.shadow-sm
        .card-header.bg-white.border-0
          h5.fw-semibold.mb-0 = t("users.show.employment")
        .card-body
          dl.row.mb-0
            dt.col-sm-3 = User.human_attribute_name(:position)
            dd.col-sm-9 = @user.position&.name
            dt.col-sm-3 = User.human_attribute_name(:hired_on)
            dd.col-sm-9 = l(@user.hired_on, format: :long)
            - if policy(@user).show_login?
              dt.col-sm-3 = User.human_attribute_name(:login)
              dd.col-sm-9 = @user.login
            - if policy(@user).show_role?
              dt.col-sm-3 = User.human_attribute_name(:role_name)
              dd.col-sm-9 = t("roles.#{@user.role_name}")

  .mt-4
    - if policy(@user).show?
      = link_to t("actions.back_to_directory"), users_path, class: "btn btn-outline-secondary"
    - if policy([:admin, @user]).update?
      = link_to t("actions.edit"), [:edit, :admin, @user], class: "btn btn-outline-primary ms-2"
    - if policy([:admin, @user]).destroy?
      = button_to t("actions.delete"), [:admin, @user], method: :delete,
        class: "btn btn-outline-danger ms-2",
        data: { turbo_confirm: t("users.confirm_delete", name: @user.full_name) }
