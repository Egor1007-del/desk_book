doctype html
html lang=I18n.locale
  head
    title
      = content_for(:title) || t("brand.name")
    meta[name="viewport" content="width=device-width,initial-scale=1"]
    meta[name="apple-mobile-web-app-capable" content="yes"]
    meta[name="application-name" content=t("brand.name")]
    meta[name="mobile-web-app-capable" content="yes"]
    = csrf_meta_tags
    = csp_meta_tag
    = yield :head
    link[rel="icon" href="/icon.png" type="image/png"]
    link[rel="icon" href="/icon.svg" type="image/svg+xml"]
    link[rel="apple-touch-icon" href="/icon.png"]
    = stylesheet_link_tag :app, "data-turbo-track": "reload"
    = javascript_importmap_tags
  body.bg-body-tertiary
    nav.navbar.bg-white.border-bottom.sticky-top[aria-label=t("navigation.main")]
      .container
        = link_to root_path, class: "navbar-brand d-flex align-items-center gap-2 fw-semibold" do
          span.brand-mark DB
          span = t("brand.name")
        .d-flex.align-items-center.gap-2
          .btn-group[role="group" aria-label=t("navigation.language")]
            - I18n.available_locales.each do |locale|
              = link_to locale.to_s.upcase, locale_switch_path(locale),
                class: "btn btn-sm #{I18n.locale == locale ? 'btn-dark' : 'btn-outline-secondary'}",
                lang: locale
          = link_to t("navigation.home"), root_path, class: "btn btn-sm btn-outline-secondary"
          - if user_signed_in?
            span.d-none.d-md-inline.text-secondary.small = current_user.full_name
            = button_to t("navigation.sign_out"), destroy_user_session_path, method: :delete,
              class: "btn btn-sm btn-dark"
          - else
            = link_to t("navigation.sign_in"), new_user_session_path, class: "btn btn-sm btn-dark"
    - flash.each do |type, message|
      - alert_class = type.to_s == "notice" ? "success" : "danger"
      .container.pt-3
        .alert.alert-dismissible.fade.show[class="alert-#{alert_class}" role="alert"]
          = message
          button.btn-close[type="button" data-bs-dismiss="alert" aria-label=t("actions.close")]
    main
      = yield
