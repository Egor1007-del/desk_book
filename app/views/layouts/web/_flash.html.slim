- flash.each do |type, message|
  - alert_class = type.to_s == "notice" ? "success" : "danger"
  .alert.alert-dismissible.fade.show[class="alert-#{alert_class}" role="alert" data-controller="flash"]
    = message
    button.btn-close[type="button" data-bs-dismiss="alert" aria-label=t("actions.close")]
